{
  "name": "starlight-llms-markdown",
  "version": "0.1.0",
  "description": "Starlight plugin that generates llms.txt and a markdown copy of every page, following llmstxt.org",
  "keywords": [
    "ai",
    "astro",
    "llm",
    "llms",
    "llms-full.txt",
    "llms.txt",
    "markdown",
    "starlight",
    "starlight-plugin",
    "withastro"
  ],
  "license": "MIT",
  "author": "yanpla",
  "files": [
    "index.ts",
    "libs",
    "routes",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./routes/*": "./routes/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mdast-util-directive": "^3.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.42.0",
    "astro": ">=7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
